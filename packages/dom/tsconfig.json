{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["esnext", "dom"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@lyapjs/reactive": ["../reactive/dist/src/index.d.ts"]
    }
  },
  "include": [
    "src/**/*"
  ]
}
